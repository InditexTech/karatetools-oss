{
    "name": "testing-config-resolver",
    "version": "1.0.0",
    "private": true,
    "description": "Resolve testing configurations",
    "main": "src/index.js",
    "scripts": {
        "lint": "eslint .",
        "prepare": "ncc build src/index.js -o dist --source-map --license licenses.txt",
