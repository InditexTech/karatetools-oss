{
  "name": "karatetools-oss",
  "version": "0.1.0",
  "private": true,
  "description": "InditexTech Karate Tools documentation, built with Antora",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "antora --fetch antora-playbook.yml",
    "dev": "docouture dev",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@inditextech/docouture-cli": "1.3.1",
    "@inditextech/docouture-ui-bundle": "1.3.1",
    "@inditextech/docouture-asciidoc-extensions": "1.3.1",
    "@inditextech/docouture-antora-extensions": "1.3.1",
    "@inditextech/docouture-publish-gh-pages": "1.3.1",
    "antora": "3.2.1",
    "patch-package": "^8.0.1"
  },
  "docouture": {
    "branching": "git-flow",
    "prereleaseBranch": "develop",
    "publish": {
      "gh-pages": {}
    }
  }
}
