{
  "name": "karatetools-oss",
  "version": "0.1.0",
  "private": true,
  "description": "InditexTech Karate Tools documentation, built with Antora",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "antora --fetch antora-playbook.yml",
    "dev": "docouture dev",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "check-links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@inditextech/docouture-cli": "0.1.0-SNAPSHOT.88.1",
    "@inditextech/docouture-ui-bundle": "0.1.0-SNAPSHOT.88.1",
    "@inditextech/docouture-asciidoc-extensions": "0.1.0-SNAPSHOT.88.1",
    "@inditextech/docouture-antora-extensions": "0.1.0-SNAPSHOT.88.1",
    "@inditextech/docouture-publish-gh-pages": "0.1.0-SNAPSHOT.88.1",
    "antora": "3.2.0",
    "linkinator": "8.0.4"
  },
  "docouture": {
    "branching": "git-flow",
    "publish": {
      "gh-pages": {}
    },
    "checkLinks": {
      "ignore": [
        "*/edit/HEAD/*",
        "https://<org>.github.io/<repo>",
        "docouture-new:no-origin-remote-configured"
      ]
    }
  }
}
